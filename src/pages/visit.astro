---
import Base from '../layouts/Base.astro';
import {site} from '../data/site.js';
---
<Base title="Visit Us | Hours, Directions & Ordering" description="Find Helena's Specialty Pierogies at 5754 Route 209, Kerhonkson, NY. Open Thursday through Sunday, 12–5 PM. Call (845) 626-2958."><section class="page-hero visit-hero"><div class="wrap"><span class="eyebrow light">WE'D LOVE TO SEE YOU</span><h1>Come on <em>in.</em></h1><p>Our family kitchen is waiting for you in Kerhonkson, New York.</p></div></section><section class="section"><div class="wrap visit-page-grid"><div><span class="eyebrow">FIND YOUR WAY</span><h2>Visit our <em>shop.</em></h2><p>Stop by for handmade pierogies, specialty meats, and a little taste of tradition. For particular varieties or larger orders, please call ahead.</p><div class="detail-block"><span class="eyebrow">ADDRESS</span><h3>5754 Route 209<br/>Kerhonkson, NY 12446</h3><a class="text-link" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Open in Google Maps ↗</a></div><div class="detail-block"><span class="eyebrow">STORE HOURS</span><h3>Thursday – Sunday<br/>12:00 PM – 5:00 PM</h3><p>In inclement weather, please call or check Facebook for updated hours.</p></div><div class="detail-block"><span class="eyebrow">PHONE</span><a class="big-phone" href={`tel:${site.phoneHref}`}>{site.phone}</a></div></div><div class="visit-instructions"><span class="asterisk">✳</span><h3>How ordering works</h3><p>Orders are placed by phone or in person. We are not accepting online, email, or Facebook orders at this time.</p><ul><li>Pierogies sold by the dozen</li><li>Specialty meats sold by the pound</li><li>Large orders: allow one week</li><li>Holiday orders: allow 2–3 weeks</li><li>Cash and local checks accepted</li><li>No shipping currently available</li></ul><a href="tel:+18456262958" class="button button-cream">Call to Order ↗</a></div></div></section><section class="map-section"><div class="wrap"><div class="map-card"><div><span class="eyebrow">A HUDSON VALLEY ORIGINAL</span><h2>Kerhonkson, New York</h2><p>Find us along Route 209.</p><a class="text-link" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Directions to Helena's ↗</a></div><div class="map-art" aria-hidden="true"><div class="map-road"></div><div class="map-pin">✳</div><span>ROUTE 209</span></div></div></div></section></Base>
