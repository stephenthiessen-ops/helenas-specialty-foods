---
import Base from '../layouts/Base.astro';
import products from '../data/products.json';
const traditional=products.filter(p=>p.category==='Traditional');
const seasonal=products.filter(p=>p.category==='Seasonal');
const meats=products.filter(p=>p.category==='Meats');
const money=v=>Number.isInteger(v)?`$${v}`:`$${v.toFixed(2)}`;
---
<Base title="Our Menu | Pierogies & Polish Meats" description="Explore Helena's handmade pierogies, seasonal flavors, and authentic Polish meats. See prices and learn how to order by phone or in person.">
<section class="page-hero page-hero-menu"><div class="wrap"><span class="eyebrow light">HANDMADE, JUST FOR YOU</span><h1>Our <em>Menu.</em></h1><p>Family favorites and authentic specialty foods, made to bring everyone to the table.</p></div></section>
<div class="ordering-banner"><div class="wrap ordering-banner-inner"><div><strong>How to order</strong><span>Order by phone or in person. No online, email, or Facebook orders at this time.</span></div><a href="tel:+18456262958" class="button button-small">Call (845) 626-2958 ↗</a></div></div>
<section class="section catalog-section"><div class="wrap"><div class="menu-toolbar"><div><span class="eyebrow">THE GOOD STUFF</span><h2>Explore our specialties.</h2></div><label class="search-label">Search the menu<input id="menu-search" type="search" placeholder="Try cheddar, bacon, kielbasa…" autocomplete="off"/></label></div><div class="filter-chips" role="group" aria-label="Filter menu"><button class="chip selected" data-filter="All" aria-pressed="true">All</button><button class="chip" data-filter="Traditional" aria-pressed="false">Pierogies</button><button class="chip" data-filter="Seasonal" aria-pressed="false">Seasonal</button><button class="chip" data-filter="Meats" aria-pressed="false">Specialty Meats</button></div>
<div class="menu-category" id="pierogies" data-category="Traditional"><div class="category-header"><div><span class="eyebrow">FROM OUR FAMILY RECIPE BOOK</span><h3>Handmade Pierogies</h3></div><span class="category-unit">Sold by the dozen</span></div><div class="product-grid">{traditional.map(p=><div class="product-row" data-name={p.name.toLowerCase()}><div class="product-decor">✳</div><div class="product-details"><h4>{p.name}</h4><span>Handmade pierogies · per dozen</span></div><strong>{money(p.price)}</strong></div>)}</div></div>
<div class="menu-category" id="seasonal" data-category="Seasonal"><div class="category-header"><div><span class="eyebrow">A LITTLE SOMETHING SPECIAL</span><h3>Seasonal Pierogies</h3></div><span class="category-unit">Availability varies · per dozen</span></div><div class="product-grid">{seasonal.map(p=><div class="product-row" data-name={p.name.toLowerCase()}><div class="product-decor">✳</div><div class="product-details"><h4>{p.name}</h4><span>Seasonal favorite · per dozen</span></div><strong>{money(p.price)}</strong></div>)}</div></div>
<div class="menu-category" id="meats" data-category="Meats"><div class="category-header"><div><span class="eyebrow">HONORING THE OLD COUNTRY</span><h3>Polish Specialty Meats</h3></div><span class="category-unit">Sold by the pound</span></div><div class="product-grid">{meats.map(p=><div class="product-row" data-name={p.name.toLowerCase()}><div class="product-decor">✳</div><div class="product-details"><h4>{p.name}</h4><span>Specialty meat · per pound</span></div><strong>{money(p.price)}</strong></div>)}</div><p class="subtle-note">Specialty meats are supplied to Helena's and availability varies by day.</p></div><p id="no-results" class="no-results" hidden>No menu items match your search. Try a different keyword.</p></div></section>
<section class="menu-notes section"><div class="wrap"><div><span class="eyebrow light">A NOTE FROM OUR KITCHEN</span><h2>Ordering <em>the traditional way.</em></h2></div><div class="notes-list"><p>All pierogies are sold by the dozen. Availability varies by day, and we recommend calling to confirm specific varieties.</p><p>Large orders require at least one week's notice. Holiday orders require 2–3 weeks' notice.</p><p>At this time we do not ship. We accept cash and local checks. Orders must be placed by phone or in person; orders through email or Facebook are not accepted.</p><p class="fine-print">Prices reproduced from the existing website in November 2026 and may change. Please call to confirm current pricing.</p></div></div></section>
</Base>
<script>
 const search=document.querySelector('#menu-search');const chips=[...document.querySelectorAll('.chip')];const groups=[...document.querySelectorAll('.menu-category')];const rows=[...document.querySelectorAll('.product-row')];let filter='All';
 function update(){const q=(search?.value||'').trim().toLowerCase();let total=0; groups.forEach(group=>{const showGroup=filter==='All'||group.dataset.category===filter;let shown=0;group.querySelectorAll('.product-row').forEach(row=>{const visible=showGroup&&(!q||row.dataset.name?.includes(q));row.hidden=!visible;if(visible){shown++;total++;}});group.hidden=shown===0;});const none=document.querySelector('#no-results');if(none)none.hidden=total!==0;}
 chips.forEach(chip=>chip.addEventListener('click',()=>{filter=chip.dataset.filter||'All';chips.forEach(c=>{const active=c===chip;c.classList.toggle('selected',active);c.setAttribute('aria-pressed',String(active));});update();}));search?.addEventListener('input',update);
</script>
